# Copy to .env and fill in. Secrets are read from the environment, never committed.

# Telegram: create a bot via @BotFather to get the token, then resolve your chat_id
# (message the bot, then GET https://api.telegram.org/bot<TOKEN>/getUpdates).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=
